DEEPSEEK_API_KEY=your_deepseek_api_key_here
GLM_API_KEY=your_glm_api_key_here
SECRET_KEY=your_secret_key_here
# Server-side root for generated Playwright workspaces.
# Keep project workspaces under this directory.
AUTOMATION_WORKSPACE_ROOT=D:\autoproject
# OpenCode executable/configuration used by the automation agent runner.
OPENCODE_BIN=opencode
# OPENCODE_CONFIG=D:\path\to\Auto_case\opencode.json
OPENCODE_TIMEOUT=3600
# Diagnostic only: skip external plugins/MCP. Keep false for the normal workflow.
OPENCODE_PURE=false
# Headless OpenCode server used to stream real-time subagent logs to the frontend.
# Host must stay loopback; the server is never exposed publicly.
OPENCODE_SERVE_HOST=127.0.0.1
# 0 = pick a free ephemeral port for each run (recommended). Set a fixed port only if needed.
OPENCODE_SERVE_PORT=0
# Seconds to wait for the server health endpoint before failing the run.
OPENCODE_SERVE_STARTUP_TIMEOUT=60
