# 数据库抢救时留下的现场文件（app.db.broken-*）：不提交
storage/app.db.*

.opencode/*
!.opencode/prompts/
.playwright-mcp/

# ---- 录制 / 测试的运行时产物 ----
# 越界改动的备份清单（guard.capture 导出的）、生成锁、校验用的临时配置
.autocase/
.autocase.verify.config.ts
test-results/
playwright-report/
playwright-report-legacy/
blob-report/
coverage/
*.tsbuildinfo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 本地临时目录（70MB 的 selenium 沙箱，之前只写在个人 .git/info/exclude 里，团队看不到）
.tmp-spike/

# ---- shots/：验证脚本要提交，截图和运行时导出不提交 ----
# 下划线前缀是「临时」的约定（_check_xxx.png、_anim_xxx.png）；仓库里留存的是
# 功能截图（agent-*.png 这类）和深浅色主题对照图（th-dark-* / th-light-*）。
shots/_*.png
shots/_*.json
shots/_*.txt
# 运行日志和跑批导出：都是一次性产物。_*.json 只匹配 shots/ 直接子级，
# _ab_out/ 这种子目录要单独写一条。
shots/_*.log
shots/_ab_out/
shots/_dialog_styles.html

# ---- docs/ 下的截图：会话里随手截的验证图，一次性产物 ----
# 上面那组只覆盖 shots/，docs/ 从来没有被忽略过，所以一轮轮验证截图全堆在
# git status 里。docs/ 根目录留给设计说明；已经跟踪的几张参考图不受影响
# （忽略规则只挡未跟踪文件，不会取消已有文件的跟踪）。
# 确实要把某张图放进仓库时，用 git add -f docs/xxx.png 显式加。
docs/*.png
docs/prototypes/*.png
docs/exports/
# opencode 每次调用生成的临时配置（含 MCP 定义），落在 cwd 时会被 git 看到
opencode.emit-*.json

# 模型配置：本地那份含明文密钥，绝不进仓库；runtime 是两份合并出来的临时产物
opencode.models.json
opencode.runtime.json
opencode.runtime.emit-*.json

# WorkBuddy 的本地记忆：每个会话一份工作记录，跟代码无关。
# 已经跟踪的历史 md 不受影响，这里只挡新生成的。
.workbuddy/

# AI 自愈沙箱：node_modules + 每次临时生成的 spec，都是运行产物。
storage/healer_sandbox/

# ---- 探针工作区：本地验证用的脚本 / 截图 / 独立仓库，不进主仓库 ----
# .probe/slider 是滑块调试的逐步截图（139 张、11M），.probe/healer-agent 里
# 有独立 .git 和 node_modules —— 单独 add 会把 22M 和一堆 gitlink 带进来。
# 这些是一次性验证产物，留在本地即可。
.probe/

# ---- 提示词实验工作区（2026-11 的 A/B 对照）----
# .tmp-promptlab 里有探针脚本、chromedriver、判分产物和 60M 归档，全是一次性验证物；
# opencode.promptlab-*.json 是那轮实验临时生成的模型配置（每个变体一份），
# .opencode/prompts/promptlab-*.md 是对应的提示词快照。实验结论已写进 docs/，
# 原始材料留在本地即可，不占仓库体积。
# 注意：.opencode/* 本来被整目录忽略，prompts/ 是显式放行的白名单，
# 所以 promptlab 这组要在白名单之后单独再挡一次。
.tmp-prompt/
.tmp-promptlab/
opencode.promptlab-*.json
.opencode/prompts/promptlab-*.md
